{
  "name": "@aimspan/desktop",
  "productName": "aimspan",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm build:brand && pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:brand": "electron ../../scripts/build-brand-assets.mjs",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"vite build --config vite.main.config.ts --watch\" \"vite build --config vite.preload.config.ts --watch\" \"wait-on tcp:127.0.0.1:5173 dist/main/index.cjs dist/preload/index.cjs && cross-env AIMSPAN_VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aimspan/core": "workspace:*",
    "@aimspan/protocol": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.0.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  }
}
