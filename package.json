{
  "name": "aimspan",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asxing/aimspan"
  },
  "homepage": "https://asxing.github.io/aimspan/",
  "bugs": {
    "url": "https://github.com/Asxing/aimspan/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:repo": "node scripts/check-repo-hygiene.mjs",
    "test:hygiene": "node --test scripts/check-repo-hygiene.test.mjs",
    "test:packages": "pnpm -r --if-present test",
    "test": "pnpm check:repo && pnpm test:hygiene && pnpm test:packages",
    "verify": "pnpm build && pnpm test && pnpm typecheck",
    "dev": "pnpm --filter @aimspan/desktop dev",
    "screenshots": "node scripts/make-screenshots.mjs",
    "package:local-mac": "pnpm build && node scripts/package-local-mac.mjs",
    "smoke:core": "node scripts/smoke-core.mjs",
    "smoke:desktop": "node scripts/smoke-desktop-lifecycle.mjs",
    "verify:smoke": "pnpm build && pnpm smoke:core && pnpm smoke:desktop"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
